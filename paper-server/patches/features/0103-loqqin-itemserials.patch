     @Deprecated
     private @Nullable Holder<Item> item;
     private PatchedDataComponentMap components;
+    // Paper start - item serials
+    /** Номера единиц стака, см. {@link io.papermc.paper.itemserial.ItemSerials}. Неизменяемый массив, заменяется целиком. */
+    public long @Nullable [] serials;
+    public io.papermc.paper.itemserial.ItemSerials.@Nullable Claim serialClaim;
+    // Paper end - item serials
     public int modCount = 0;
 
     public static DataResult<ItemStack> validateStrict(final ItemStack itemStack) {
@@ -793,6 +799,7 @@ public final class ItemStack implements DataComponentHolder, ItemInstance {
         ItemStack copy = new ItemStack(originalItem ? this.item : this.typeHolder(), this.count, this.components.copy()); // Paper - Perf: Optimize Hoppers
         copy.setPopTime(this.getPopTime());
         copy.modCount = modCount;
+        io.papermc.paper.itemserial.ItemSerials.onCopy(this, copy); // Paper - item serials
         return copy;
     }
 
@@ -1313,10 +1320,35 @@ public final class ItemStack implements DataComponentHolder, ItemInstance {
     }
 
     public void setCount(final int count) {
+        if (this.serials != null) io.papermc.paper.itemserial.ItemSerials.onSetCount(this, this.getCount(), count); // Paper - item serials
         this.count = count;
         modCount++;
     }
 
+    // Paper start - item serials
+    /** Меняет количество, не трогая номера. Только для {@link io.papermc.paper.itemserial.ItemSerials}. */
+    public void setCountRaw(final int count) {
+        this.count = count;
+        modCount++;
+    }
+
+    /**
+     * Как {@link #grow}, но прибавленные единицы берутся из {@code source} вместе с номерами.
+     * {@code source} не уменьшается: вызывающий код уменьшает его сам, в том же тике и после этого вызова.
+     */
+    public void growFrom(final ItemStack source, final int amount) {
+        if (amount <= 0 || this == EMPTY || !io.papermc.paper.itemserial.ItemSerials.ENABLED || (source.serials == null && this.serials == null)) {
+            this.grow(amount);
+            return;
+        }
+        final int oldCount = this.getCount();
+        final long[] given = io.papermc.paper.itemserial.ItemSerials.give(source, this, amount);
+        final long[] newSerials = io.papermc.paper.itemserial.ItemSerials.concat(oldCount > 0 ? this.serials : null, oldCount, given, amount);
+        this.setCountRaw(oldCount + amount);
+        this.serials = newSerials;
+    }
+    // Paper end - item serials
+
     public void limitSize(final int maxStackSize) {
         if (!this.isEmpty() && this.getCount() > maxStackSize) {
             this.setCount(maxStackSize);
