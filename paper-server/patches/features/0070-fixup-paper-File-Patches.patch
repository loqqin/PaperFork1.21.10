diff --git a/net/minecraft/network/chat/MutableComponent.java b/net/minecraft/network/chat/MutableComponent.java
index 71eca0df9970a1cf3cb2673f373a145ab99fbb50..b15cbbbd994d95f35e08a76ec4f9dae990375127 100755
