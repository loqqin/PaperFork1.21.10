@@ -3936,6 +3936,11 @@ public abstract class Entity
     }
 
     protected void moveTowardsClosestSpace(final double x, final double y, final double z) {
+        org.bukkit.event.entity.MoveTowardsClosestSpaceEvent event = new org.bukkit.event.entity.MoveTowardsClosestSpaceEvent(getBukkitEntity());
+        org.bukkit.Bukkit.getPluginManager().callEvent(event);
+        if (event.isCancelled()) {
+            return;
+        }
         BlockPos pos = BlockPos.containing(x, y, z);
         Vec3 delta = new Vec3(x - pos.getX(), y - pos.getY(), z - pos.getZ());
         BlockPos.MutableBlockPos neighborPos = new BlockPos.MutableBlockPos();
