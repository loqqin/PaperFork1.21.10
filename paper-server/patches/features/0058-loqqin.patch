@@ -78,11 +78,36 @@ public class CactusBlock extends Block {
             }
 
             if (age < 15) {
-                level.setBlock(pos, state.setValue(AGE, age + 1), Block.UPDATE_NONE);
+                int multiplier = getMultiplier(growthPercentIncrease.getDouble(level.serverLevelData.settings.levelName));
+                int i1 = 1 + multiplier;
+                level.setBlock(pos, state.setValue(AGE, Math.min(15, age + i1)), Block.UPDATE_NONE);
             }
         }
     }
 
+    public static boolean randomChance(Number chance) {
+        double v = chance.doubleValue();
+        if (v >= 100) {
+            return true;
+        }
+        if (v <= 0) {
+            return false;
+        }
+        return Math.random() * 100 <= v;
+    }
+
+    private static int getMultiplier(double fortune) {
+        int multiplier = 1;
+        while (fortune >= 100) {
+            multiplier++;
+            fortune -= 100;
+        }
+        if (randomChance((float) fortune)) {
+            multiplier++;
+        }
+        return multiplier;
+    }
+
     @Override
     protected VoxelShape getCollisionShape(final BlockState state, final BlockGetter level, final BlockPos pos, final CollisionContext context) {
         return SHAPE_COLLISION;
