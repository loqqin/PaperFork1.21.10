diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index c0ed4e023b35a076b554fa387e9a2324166b2fae..cef078765a69988350ab6fea0a6a210fd63c8b62 100755
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -1015,12 +1015,21 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
     public void tickPrecipitation(BlockPos pos) {
         BlockPos heightmapPos = this.getHeightmapPos(Heightmap.Types.MOTION_BLOCKING, pos);
         BlockPos blockPos = heightmapPos.below();
+
+        boolean raining = this.isRaining();
+        BlockState belowState = this.getBlockState(blockPos);
+        boolean isWater = belowState.is(Blocks.WATER);
+
+        if (!raining && !isWater) {
+            return;
+        }
+
         Biome biome = this.getBiome(heightmapPos).value();
-        if (biome.shouldFreeze(this, blockPos)) {
-            org.bukkit.craftbukkit.event.CraftEventFactory.handleBlockFormEvent(this, blockPos, Blocks.ICE.defaultBlockState(), 3, null); // CraftBukkit
+        if (isWater && biome.shouldFreeze(this, blockPos)) {
+            org.bukkit.craftbukkit.event.CraftEventFactory.handleBlockFormEvent(this, blockPos, Blocks.ICE.defaultBlockState(), 3, null);
         }
 
-        if (this.isRaining()) {
+        if (raining) {
             int _int = this.getGameRules().getInt(GameRules.RULE_SNOW_ACCUMULATION_HEIGHT);
             if (_int > 0 && biome.shouldSnow(this, heightmapPos)) {
                 BlockState blockState = this.getBlockState(heightmapPos);
@@ -1029,17 +1038,16 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
                     if (layersValue < Math.min(_int, 8)) {
                         BlockState blockState1 = blockState.setValue(SnowLayerBlock.LAYERS, layersValue + 1);
                         Block.pushEntitiesUp(blockState, blockState1, this, heightmapPos);
-                        org.bukkit.craftbukkit.event.CraftEventFactory.handleBlockFormEvent(this, heightmapPos, blockState1, 3, null); // CraftBukkit
+                        org.bukkit.craftbukkit.event.CraftEventFactory.handleBlockFormEvent(this, heightmapPos, blockState1, 3, null);
                     }
                 } else {
-                    org.bukkit.craftbukkit.event.CraftEventFactory.handleBlockFormEvent(this, heightmapPos, Blocks.SNOW.defaultBlockState(), 3, null); // CraftBukkit
+                    org.bukkit.craftbukkit.event.CraftEventFactory.handleBlockFormEvent(this, heightmapPos, Blocks.SNOW.defaultBlockState(), 3, null);
                 }
             }
 
             Biome.Precipitation precipitationAt = biome.getPrecipitationAt(blockPos, this.getSeaLevel());
             if (precipitationAt != Biome.Precipitation.NONE) {
-                BlockState blockState2 = this.getBlockState(blockPos);
-                blockState2.getBlock().handlePrecipitation(blockState2, this, blockPos, precipitationAt);
+                belowState.getBlock().handlePrecipitation(belowState, this, blockPos, precipitationAt);
             }
         }
     }
