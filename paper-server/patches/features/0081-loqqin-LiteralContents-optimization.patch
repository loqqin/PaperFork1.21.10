From: aaa <121246396+loqqin@users.noreply.github.com>
Date: Tue, 18 Aug 2026 17:04:42 +0300
Subject: [PATCH] loqqin LiteralContents optimization


diff --git a/net/minecraft/network/chat/contents/PlainTextContents.java b/net/minecraft/network/chat/contents/PlainTextContents.java
index 938d122317c77e1f703be714f81e66e829119b69..74e63de061a01c53c16c265dd5cc7fbb9d54afee 100644
--- a/net/minecraft/network/chat/contents/PlainTextContents.java
+++ b/net/minecraft/network/chat/contents/PlainTextContents.java
@@ -36,6 +36,18 @@ public interface PlainTextContents extends ComponentContents {
     }
 
     record LiteralContents(@Override String text) implements PlainTextContents {
+        @Override
+        public boolean equals(Object o) {
+            if (this == o) return true;
+            if (!(o instanceof net.minecraft.network.chat.contents.PlainTextContents.LiteralContents(String text1))) return false;
+            return this.text.equals(text1);
+        }
+
+        @Override
+        public int hashCode() {
+            return text.hashCode();
+        }
+
         @Override
         public <T> Optional<T> visit(final FormattedText.ContentConsumer<T> output) {
             return output.accept(this.text);
