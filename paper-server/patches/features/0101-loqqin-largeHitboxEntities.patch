@@ -1925,6 +1925,22 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
 
     public abstract Collection<EnderDragonPart> dragonParts();
 
+    // Сущности шире или выше 4 блоков: поиск по секциям их не находит, если область поиска задевает только край хитбокса.
+    // Добавляются в результат getEntities через PlatformHooks#addToGetEntities, как части дракона.
+    public final it.unimi.dsi.fastutil.ints.Int2ObjectOpenHashMap<Entity> largeHitboxEntities = new it.unimi.dsi.fastutil.ints.Int2ObjectOpenHashMap<>();
+
+    public static boolean hasLargeHitbox(final Entity entity) {
+        return !(entity instanceof EnderDragon) && (entity.getBbWidth() > 4.0F || entity.getBbHeight() > 4.0F);
+    }
+
+    public void updateLargeHitbox(final Entity entity) {
+        if (hasLargeHitbox(entity)) {
+            this.largeHitboxEntities.put(entity.getId(), entity);
+        } else {
+            this.largeHitboxEntities.remove(entity.getId());
+        }
+    }
