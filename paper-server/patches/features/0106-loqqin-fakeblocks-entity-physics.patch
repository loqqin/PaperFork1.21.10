diff --git a/net/minecraft/world/level/ClipContext.java b/net/minecraft/world/level/ClipContext.java
index 322c9e416d7fa3b567be8e67b8fa0b8995a78a16..f101a97a646bb124bfa5fed26ce6913ec4921e5c 100644
--- a/net/minecraft/world/level/ClipContext.java
+++ b/net/minecraft/world/level/ClipContext.java
@@ -25,6 +25,12 @@ public class ClipContext {
     public final ClipContext.Fluid fluid; // Paper - optimise collisions - public
     private final CollisionContext collisionContext;
 
+    // loqqin start - сущность луча нужна Level.fastClip для фейковых блоков её physicsViewer
+    public @org.jspecify.annotations.Nullable Entity getEntity() {
+        return this.collisionContext instanceof net.minecraft.world.phys.shapes.EntityCollisionContext entityCollisionContext ? entityCollisionContext.getEntity() : null;
+    }
+    // loqqin end
+
     public ClipContext(final Vec3 from, final Vec3 to, final ClipContext.Block block, final ClipContext.Fluid fluid, final Entity entity) {
         this(from, to, block, fluid, (entity == null) ? CollisionContext.empty() : CollisionContext.of(entity)); // CraftBukkit
     }
diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index 747e75440f800d8a25c6294cd18f852c25090d65..f1147ffde06f93ba42eda2b516bb248cb08fda11 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -420,6 +420,10 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
         int lastChunkZ = Integer.MIN_VALUE;
 
         final int minSection = ca.spottedleaf.moonrise.common.util.WorldUtil.getMinSection(level);
+        // loqqin start - луч сущности с physicsViewer (снаряд игрока) видит фейковые блоки этого игрока
+        final Entity clipEntity = clipContext.getEntity();
+        final net.minecraft.server.level.ServerPlayer fakeViewer = clipEntity == null || !(level instanceof ServerLevel) ? null : clipEntity.getPhysicsViewer();
+        // loqqin end
 
         for (;;) {
             currPos.set(currX, currY, currZ);
@@ -443,8 +447,13 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
                 lastChunkZ = newChunkZ;
             }
 
-            final BlockState blockState;
-            if (lastSection != null && !(blockState = lastSection.get((currX & 15) | ((currZ & 15) << 4) | ((currY & 15) << (4+4)))).isAir()) {
+            BlockState blockState = lastSection == null ? null : lastSection.get((currX & 15) | ((currZ & 15) << 4) | ((currY & 15) << (4+4)));
+            // loqqin start
+            if (fakeViewer != null && lastSection != null) {
+                blockState = net.FakeBlocks.function.apply(fakeViewer, currPos.immutable(), (ServerLevel) level);
+            }
+            // loqqin end
+            if (blockState != null && !blockState.isAir()) {
                 final VoxelShape blockCollision = clipContext.getBlockShape(blockState, level, currPos);
 
                 final net.minecraft.world.phys.BlockHitResult blockHit = blockCollision.isEmpty() ? null : level.clipWithInteractionOverride(from, to, currPos, blockCollision, blockState);
