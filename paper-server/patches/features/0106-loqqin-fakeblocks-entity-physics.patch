diff --git a/ca/spottedleaf/moonrise/patches/collisions/CollisionUtil.java b/ca/spottedleaf/moonrise/patches/collisions/CollisionUtil.java
index 3b4cec84766df8b6668b9c9e5ff5915dd2fc4453..f5acc250d2ec628ff326ebe15c49ff793a8270ea 100644
--- a/ca/spottedleaf/moonrise/patches/collisions/CollisionUtil.java
+++ b/ca/spottedleaf/moonrise/patches/collisions/CollisionUtil.java
@@ -1946,8 +1946,8 @@ public final class CollisionUtil {
         if (entity instanceof ServerPlayer serverPlayer) {
             fakeViewer = serverPlayer;
             fakeLevel = serverPlayer.level();
-        } else if (entity instanceof net.minecraft.world.entity.item.ItemEntity itemEntity && world instanceof net.minecraft.server.level.ServerLevel serverLevel) {
-            fakeViewer = itemEntity.getPhysicsViewer();
+        } else if (entity != null && world instanceof net.minecraft.server.level.ServerLevel serverLevel) {
+            fakeViewer = entity.getPhysicsViewer();
             fakeLevel = serverLevel;
         }
         // loqqin end
diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 5135b1c950cf0ec4521e61c615e90f3e8046904f..221cc278d7e0166f792e78c79dd3dc90db3c2837 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -298,6 +298,18 @@ public abstract class Entity
     public double yOld;
     public double zOld;
     public boolean noPhysics;
+    // loqqin start - коллизии и попадания сущности по фейковым блокам этого игрока (net.FakeBlocks), как их видит его клиент.
+    // Иначе клиент роняет предмет в фейковую дыру, а сервер держит его на настоящем блоке, или снаряд врезается в невидимый блок.
+    // Не сохраняется в NBT
+    public @Nullable UUID physicsViewer;
+
+    public @Nullable ServerPlayer getPhysicsViewer() {
+        if (this.physicsViewer == null || !(this.level() instanceof ServerLevel serverLevel)) {
+            return null;
+        }
+        return serverLevel.getServer().getPlayerList().getPlayer(this.physicsViewer);
+    }
+    // loqqin end
     protected final RandomSource random = SHARED_RANDOM; // Paper - Share random for entities to make them more random
     public int tickCount;
     private int remainingFireTicks;
